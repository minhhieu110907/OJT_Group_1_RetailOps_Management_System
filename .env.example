# Copy this file to .env and replace every CHANGE_ME value with a unique,
# locally generated credential. Never commit .env.

# Docker Compose: MySQL initialization and host bindings.
MYSQL_DATABASE=retailops
MYSQL_TEST_DATABASE=retailops_test
MYSQL_USER=retailops_app
MYSQL_PASSWORD=CHANGE_ME_GENERATE_A_LOCAL_PASSWORD
MYSQL_TEST_USER=retailops_test_runner
MYSQL_TEST_PASSWORD=CHANGE_ME_GENERATE_A_SEPARATE_TEST_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_ROOT_PASSWORD
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=8000
NGINX_HOST_PORT=80
REDIS_HOST_PORT=6379

# Host-side integration tests only. These identity values are checked exactly.
# Keep this URL's host port synchronized with MYSQL_HOST_PORT and URL-encode
# special characters in MYSQL_TEST_PASSWORD.
RETAILOPS_TEST_DATABASE_URL=mysql+pymysql://retailops_test_runner:CHANGE_ME_GENERATE_A_SEPARATE_TEST_PASSWORD@127.0.0.1:3306/retailops_test?charset=utf8mb4


# Admin seed — chỉ dùng khi chạy lệnh seed
RETAILOPS_ADMIN_SEED_EMAIL=
RETAILOPS_ADMIN_SEED_PASSWORD=

# React development — CORS
RETAILOPS_CORS_ORIGINS=http://127.0.0.1:5173

# Auth secrets are independent and must each contain at least 32 random bytes.
RETAILOPS_JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
RETAILOPS_CSRF_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_32_BYTE_SECRET
RETAILOPS_JWT_ISSUER=retailops-api
RETAILOPS_JWT_AUDIENCE=retailops-api
# Local HTTP development only. Production always enforces Secure cookies.
RETAILOPS_COOKIE_SECURE=false

# Redis rate limiting. Redis itself is not published outside loopback locally.
RETAILOPS_REDIS_URL=redis://redis:6379/0
RETAILOPS_REDIS_POOL_SIZE=10
RETAILOPS_REDIS_CONNECT_TIMEOUT_SECONDS=1
RETAILOPS_REDIS_SOCKET_TIMEOUT_SECONDS=1
RETAILOPS_REGISTER_RATE_LIMIT=5
RETAILOPS_REGISTER_RATE_WINDOW_SECONDS=60
