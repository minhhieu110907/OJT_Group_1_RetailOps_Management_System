# Copy this file to .env and replace every CHANGE_ME value with a unique,
# locally generated credential. Never commit .env.

# Docker Compose: MySQL initialization and host bindings.
MYSQL_DATABASE=retailops
MYSQL_TEST_DATABASE=retailops_test
MYSQL_USER=retailops_app
MYSQL_PASSWORD=CHANGE_ME_GENERATE_A_LOCAL_PASSWORD
MYSQL_TEST_USER=retailops_test_runner
MYSQL_TEST_PASSWORD=CHANGE_ME_GENERATE_A_SEPARATE_TEST_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_A_DIFFERENT_ROOT_PASSWORD

# Host port mappings:
# Services with published ports are bound to host loopback (127.0.0.1) only, preventing access from external networks.
# On Windows, port 3306 is frequently reserved by Hyper-V / WinNAT or occupied by a local MySQL service.
# If port 3306 fails to bind, change MYSQL_HOST_PORT=13306 and synchronize RETAILOPS_TEST_DATABASE_URL below.
MYSQL_HOST_PORT=3306
BACKEND_HOST_PORT=8000
# On Windows, port 80 may be occupied by IIS or HTTP.sys (System PID 4). If so, change NGINX_HOST_PORT=8080.
NGINX_HOST_PORT=80
REDIS_HOST_PORT=6379

# RabbitMQ bootstrap and separated runtime identities. Generate unique passwords.
# Email services are opt-in: docker compose --profile email --profile email-local up -d
RABBITMQ_BOOTSTRAP_USER=retailops_topology
RABBITMQ_BOOTSTRAP_PASSWORD=CHANGE_ME_GENERATE_A_BROKER_ADMIN_PASSWORD
RABBITMQ_PUBLISHER_USER=retailops_outbox_publisher
RABBITMQ_PUBLISHER_PASSWORD=CHANGE_ME_GENERATE_A_PUBLISHER_PASSWORD
RABBITMQ_WORKER_USER=retailops_email_worker
RABBITMQ_WORKER_PASSWORD=CHANGE_ME_GENERATE_A_WORKER_PASSWORD

# Local/testing worker uses Mailpit. Production must override all provider values,
# set RETAILOPS_ENVIRONMENT=production, and enable STARTTLS.
RETAILOPS_SMTP_HOST=mailpit
RETAILOPS_SMTP_PORT=1025
RETAILOPS_SMTP_USERNAME=
RETAILOPS_SMTP_PASSWORD=
RETAILOPS_SMTP_FROM_ADDRESS=no-reply@retailops.local
RETAILOPS_SMTP_STARTTLS=false

# Host-side integration tests only. These identity values are checked exactly.
# Keep this URL's host port synchronized with MYSQL_HOST_PORT and URL-encode
# special characters in MYSQL_TEST_PASSWORD.
# (e.g., if MYSQL_HOST_PORT=13306, set @127.0.0.1:13306/retailops_test)
RETAILOPS_TEST_DATABASE_URL=mysql+pymysql://retailops_test_runner:CHANGE_ME_GENERATE_A_SEPARATE_TEST_PASSWORD@127.0.0.1:3306/retailops_test?charset=utf8mb4


# Admin seed — chỉ dùng khi chạy lệnh seed
RETAILOPS_ADMIN_SEED_EMAIL= 
RETAILOPS_ADMIN_SEED_PASSWORD= 
RETAILOPS_ADMIN_SEED_FULL_NAME=

# React development — CORS
RETAILOPS_CORS_ORIGINS=http://127.0.0.1:5173

# Auth secrets are independent and must each contain at least 32 random bytes.
RETAILOPS_JWT_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_BYTES
RETAILOPS_CSRF_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_32_BYTE_SECRET
RETAILOPS_IDEMPOTENCY_SECRET=CHANGE_ME_GENERATE_ANOTHER_32_BYTE_SECRET
RETAILOPS_OUTBOX_SECRET_KEY=CHANGE_ME_GENERATE_OUTBOX_32_BYTE_SECRET
RETAILOPS_JWT_ISSUER=retailops-api
RETAILOPS_JWT_AUDIENCE=retailops-api
# Local HTTP development only. Production always enforces Secure cookies.
RETAILOPS_COOKIE_SECURE=false

# Redis rate limiting. Redis itself is not published outside loopback locally.
RETAILOPS_REDIS_URL=redis://redis:6379/0
RETAILOPS_REDIS_POOL_SIZE=10
RETAILOPS_REDIS_CONNECT_TIMEOUT_SECONDS=1
RETAILOPS_REDIS_SOCKET_TIMEOUT_SECONDS=1
RETAILOPS_REGISTER_RATE_LIMIT=5
RETAILOPS_REGISTER_RATE_WINDOW_SECONDS=60
RETAILOPS_LOGIN_IP_RATE_LIMIT=5
RETAILOPS_LOGIN_IP_RATE_WINDOW_SECONDS=60
RETAILOPS_LOGIN_ACCOUNT_RATE_LIMIT=20
RETAILOPS_LOGIN_ACCOUNT_RATE_WINDOW_SECONDS=3600
RETAILOPS_REFRESH_RATE_LIMIT=10
RETAILOPS_REFRESH_RATE_WINDOW_SECONDS=60
RETAILOPS_BUSINESS_RATE_LIMIT=120
RETAILOPS_BUSINESS_RATE_WINDOW_SECONDS=60
RETAILOPS_GEMINI_API_KEY=
RETAILOPS_GEMINI_MODEL=gemini-2.5-flash
RETAILOPS_GEMINI_TIMEOUT_SECONDS=10
RETAILOPS_AI_RATE_LIMIT=10
RETAILOPS_AI_RATE_WINDOW_SECONDS=60
RETAILOPS_AI_MAX_CONCURRENT_REQUESTS=5

# Optional: Host-side integration test runners targeting compose.ci.yaml
# When running integration tests against compose.ci.yaml, Redis is exposed on REDIS_HOST_PORT (default 16379).
# RETAILOPS_TEST_REDIS_URL=redis://127.0.0.1:16379/15
# RETAILOPS_PROXY_BASE_URL=http://127.0.0.1:18080
# RETAILOPS_PROXY_REDIS_URL=redis://127.0.0.1:16379/0
