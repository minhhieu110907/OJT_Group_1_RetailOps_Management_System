# Base URL cho Axios client. Mặc định dùng đường dẫn tương đối để đi qua Vite proxy khi chạy local.
VITE_API_BASE_URL=/api/v1

# Địa chỉ FastAPI Backend đích cho Vite dev proxy (chỉ áp dụng cho môi trường local dev).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Thời gian chờ tối đa cho mỗi request (ms).
VITE_API_TIMEOUT=10000
