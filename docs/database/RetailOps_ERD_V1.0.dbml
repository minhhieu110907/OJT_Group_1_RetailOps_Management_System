Project retailops_v1 {
  database_type: 'MySQL'
  Note: 'Design Baseline (PO agreed, pending MySQL migration validation) | Outbox Lite | RetailOps V1.0 | SRS V1.3 | TD-01, TD-03, TD-04; TD-04E scoped to single publisher and sequential worker | MySQL 8 InnoDB | UTC | one store and warehouse'
}

Table users {
  id bigint [pk, increment]
  email_normalized varchar(254) [not null, unique, note: 'ASCII canonical email, binary collation in migration']
  password_hash varchar(255) [not null]
  role varchar(5) [not null]
  status varchar(16) [not null]
  admin_slot tinyint [unique, note: '1 for ADMIN, NULL for STAFF']
  last_reapplied_at datetime(6) [note: 'UTC; updated only when verified reapplication is accepted, not when proof email is requested']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  checks {
    `(role = 'ADMIN' AND admin_slot IS NOT NULL AND admin_slot = 1 AND status = 'ACTIVE') OR (role = 'STAFF' AND admin_slot IS NULL AND status IN ('PENDING_APPROVAL','ACTIVE','REJECTED'))`
  }
}

Table staff_approval_requests {
  id bigint [pk, increment]
  user_id bigint [not null]
  attempt_no int [not null]
  status varchar(10) [not null]
  requested_at datetime(6) [not null]
  decided_by bigint
  decided_at datetime(6)
  decision_reason varchar(500) [note: 'Optional decision rationale; immutable after the review decision is committed']
  indexes {
    (user_id, attempt_no) [unique]
    (status, requested_at, id)
  }
  checks {
    `attempt_no > 0`
    `(status = 'PENDING' AND decided_by IS NULL AND decided_at IS NULL) OR (status IN ('APPROVED','REJECTED') AND decided_by IS NOT NULL AND decided_at IS NOT NULL AND decided_at >= requested_at)`
  }
}

// TD-04D: Lock auth_sessions row during each refresh rotation; consume the prior digest and insert next generation atomically.
// Every protected request verifies the live session and ACTIVE user through MySQL, not a JWT alone.
Table auth_sessions {
  id binary(16) [pk]
  user_id bigint [not null]
  created_at datetime(6) [not null]
  expires_at datetime(6) [not null]
  revoked_at datetime(6)
  indexes {
    (user_id, revoked_at)
    expires_at
  }
  checks {
    `expires_at > created_at AND expires_at <= DATE_ADD(created_at, INTERVAL 8 HOUR)`
  }
}

Table refresh_tokens {
  token_digest binary(32) [pk]
  session_id binary(16) [not null]
  generation int [not null]
  issued_at datetime(6) [not null]
  consumed_at datetime(6)
  indexes {
    (session_id, generation) [unique]
  }
  checks {
    `generation >= 0 AND (consumed_at IS NULL OR consumed_at >= issued_at)`
  }
}

Table account_action_tokens {
  token_digest binary(32) [pk]
  user_id bigint [not null]
  purpose varchar(14) [not null, note: 'PASSWORD_RESET or STAFF_REAPPLY; store only SHA-256 digest of cryptographically random opaque token']
  created_at datetime(6) [not null]
  expires_at datetime(6) [not null]
  consumed_at datetime(6)
  indexes {
    (user_id, purpose, consumed_at)
    expires_at
  }
  checks {
    `purpose IN ('PASSWORD_RESET','STAFF_REAPPLY') AND expires_at > created_at`
    `(purpose <> 'STAFF_REAPPLY' OR expires_at = DATE_ADD(created_at, INTERVAL 15 MINUTE))`
    `(consumed_at IS NULL OR consumed_at >= created_at)`
  }
}

Table categories {
  id bigint [pk, increment]
  name varchar(120) [not null]
  status varchar(8) [not null, default: 'ACTIVE']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  checks {
    `status IN ('ACTIVE','INACTIVE')`
  }
}

Table suppliers {
  id bigint [pk, increment]
  name varchar(160) [not null]
  contact_email varchar(254)
  contact_phone varchar(32)
  status varchar(8) [not null, default: 'ACTIVE']
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  checks {
    `status IN ('ACTIVE','INACTIVE')`
  }
}

Table products {
  id bigint [pk, increment]
  category_id bigint [not null]
  sku varchar(64) [not null, unique, note: 'ASCII canonical SKU, binary collation in migration']
  name varchar(160) [not null]
  status varchar(8) [not null, default: 'ACTIVE']
  sale_price_vnd bigint [not null]
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  indexes {
    (category_id, status, id)
    (status, id)
    (name, id)
  }
  checks {
    `status IN ('ACTIVE','INACTIVE') AND sale_price_vnd > 0`
  }
}

// TD-03: Terminal transitions are one-way. Service locks the receipt header, then ordered product/inventory rows.
// DRAFT may be edited; CONFIRMED and CANCELLED must remain immutable through all write paths.
Table purchase_receipts {
  id bigint [pk, increment]
  supplier_id bigint [not null]
  supplier_name_snapshot varchar(160) [note: 'Capture current supplier name on CONFIRM; on CANCEL preserve draft supplier name at cancellation; terminal history immutable']
  status varchar(9) [not null, default: 'DRAFT']
  draft_version bigint [not null, default: 1]
  total_vnd bigint [not null, default: 0]
  created_by bigint [not null]
  closed_by bigint
  created_at datetime(6) [not null]
  updated_at datetime(6) [not null]
  closed_at datetime(6)
  indexes {
    (created_at, id)
    (status, created_at, id)
    (supplier_id, created_at, id)
  }
  checks {
    `draft_version >= 1 AND total_vnd >= 0`
    `(status = 'DRAFT' AND closed_by IS NULL AND closed_at IS NULL) OR (status IN ('CONFIRMED','CANCELLED') AND closed_by IS NOT NULL AND closed_at IS NOT NULL AND supplier_name_snapshot IS NOT NULL)`
  }
}

Table purchase_receipt_items {
  receipt_id bigint [not null]
  product_id bigint [not null]
  sku_snapshot varchar(64) [not null, note: 'Draft: stored on add/edit; CONFIRM: refresh under Product lock and freeze; CANCEL: preserve latest draft snapshot and freeze']
  product_name_snapshot varchar(160) [not null, note: 'Snapshot frozen on terminal transition, including CANCELLED draft']
  quantity int [not null]
  unit_cost_vnd bigint [not null]
  line_total_vnd bigint [not null]
  indexes {
    (receipt_id, product_id) [pk]
  }
  checks {
    `quantity > 0 AND unit_cost_vnd >= 0 AND line_total_vnd = CAST(quantity AS DECIMAL(30,0)) * unit_cost_vnd`
  }
}

// TD-04B: Inventory mutations share a lock hierarchy and one transaction: header (if any) -> Product IDs sorted ascending -> Inventory IDs sorted ascending.
// Every non-no-op mutation updates stock_version and writes its stock movement in the same transaction.
Table inventory {
  product_id bigint [pk]
  quantity int [not null, default: 0]
  stock_version bigint [not null, default: 0]
  first_stocked_at datetime(6)
  updated_at datetime(6) [not null]
  indexes {
    (quantity, product_id)
  }
  checks {
    `quantity >= 0 AND stock_version >= 0 AND (quantity = 0 OR first_stocked_at IS NOT NULL)`
  }
}

Table inventory_adjustments {
  id bigint [pk, increment]
  product_id bigint [not null]
  actor_id bigint [not null]
  reason varchar(500) [not null]
  quantity_before int [not null]
  counted_quantity int [not null]
  version_before bigint [not null]
  created_at datetime(6) [not null]
  indexes {
    (id, product_id) [unique]
    (product_id, created_at, id)
  }
  checks {
    `quantity_before >= 0 AND counted_quantity >= 0 AND version_before >= 0 AND CHAR_LENGTH(TRIM(reason)) > 0`
  }
}

Table orders {
  id bigint [pk, increment]
  status varchar(9) [not null, default: 'COMPLETED']
  total_vnd bigint [not null]
  created_by bigint [not null]
  sold_at datetime(6) [not null]
  cancelled_by bigint
  cancelled_at datetime(6)
  cancel_reason varchar(500)
  indexes {
    (sold_at, id)
    (status, sold_at, id)
  }
  checks {
    `total_vnd > 0`
    `(status = 'COMPLETED' AND cancelled_by IS NULL AND cancelled_at IS NULL AND cancel_reason IS NULL) OR (status = 'CANCELLED' AND cancelled_by IS NOT NULL AND cancelled_at IS NOT NULL AND cancelled_at >= sold_at AND cancel_reason IS NOT NULL AND CHAR_LENGTH(TRIM(cancel_reason)) > 0)`
  }
}

Table order_items {
  order_id bigint [not null]
  product_id bigint [not null]
  sku_snapshot varchar(64) [not null]
  product_name_snapshot varchar(160) [not null]
  quantity int [not null]
  unit_price_vnd bigint [not null]
  line_total_vnd bigint [not null]
  indexes {
    (order_id, product_id) [pk]
  }
  checks {
    `quantity > 0 AND unit_price_vnd > 0 AND line_total_vnd = CAST(quantity AS DECIMAL(30,0)) * unit_price_vnd`
  }
}

Table stock_movements {
  id bigint [pk, increment]
  product_id bigint [not null]
  actor_id bigint [not null]
  kind varchar(16) [not null]
  receipt_id bigint
  order_id bigint
  adjustment_id bigint
  sku_snapshot varchar(64) [not null]
  quantity_before int [not null]
  quantity_after int [not null]
  stock_version_after bigint [not null]
  occurred_at datetime(6) [not null]
  indexes {
    (product_id, stock_version_after) [unique]
    (receipt_id, product_id) [unique]
    (order_id, product_id, kind) [unique]
    (adjustment_id, product_id) [unique]
    (product_id, occurred_at, id)
    (occurred_at, id)
  }
  checks {
    `quantity_before >= 0 AND quantity_after >= 0 AND quantity_before <> quantity_after AND stock_version_after > 0`
    `(kind = 'PURCHASE_CONFIRM' AND receipt_id IS NOT NULL AND order_id IS NULL AND adjustment_id IS NULL AND quantity_after > quantity_before) OR (kind IN ('SALE','ORDER_CANCEL') AND order_id IS NOT NULL AND receipt_id IS NULL AND adjustment_id IS NULL AND ((kind = 'SALE' AND quantity_after < quantity_before) OR (kind = 'ORDER_CANCEL' AND quantity_after > quantity_before))) OR (kind = 'ADJUSTMENT' AND adjustment_id IS NOT NULL AND receipt_id IS NULL AND order_id IS NULL)`
  }
}

// TD-04C (Option A APPROVED): claim + business effect + persisted response are one MySQL transaction.
// Duplicate callers may wait briefly on the unique key, then replay completed result or return 409/425. No claim lease is required.
Table idempotency_records {
  user_id bigint [not null]
  operation varchar(20) [not null]
  key_digest binary(32) [not null]
  request_digest binary(32) [not null]
  response_status smallint
  response_body json
  created_at datetime(6) [not null]
  completed_at datetime(6)
  expires_at datetime(6)
  indexes {
    (user_id, operation, key_digest) [pk, note: 'TD-04C: INSERT claim, execute command, and store completed response before a single COMMIT; never commit IN_PROGRESS alone']
    expires_at
  }
  checks {
    `operation IN ('CHECKOUT','CONFIRM_RECEIPT','CANCEL_ORDER','INVENTORY_ADJUSTMENT')`
    `(response_status IS NULL AND response_body IS NULL AND completed_at IS NULL AND expires_at IS NULL) OR (response_status IS NOT NULL AND response_status BETWEEN 200 AND 499 AND response_body IS NOT NULL AND completed_at IS NOT NULL AND expires_at IS NOT NULL AND expires_at = DATE_ADD(completed_at, INTERVAL 24 HOUR))`
  }
}

// TD-04E-LITE: One publisher instance + one sequential email worker in RetailOps V1.
// One business transaction inserts business data + this event. Publisher sends only committed events.
// Publisher confirms RabbitMQ acceptance before writing published_at. Crash between these steps can republish.
// Worker uses event id to check terminal outcome; durable Celery retries handle temporary SMTP failures.
// No dual DB leases/fencing in V1. Do NOT run two publisher instances or concurrent email consumers
// until claim/lease and consumer coordination are designed and integration-tested.
// Email delivery is at-least-once intent processing, NOT external SMTP exactly-once.
Table outbox_events {
  id binary(16) [pk, note: 'Stable event ID; message body to RabbitMQ contains this ID, not an authentication secret']
  subject_user_id bigint [not null]
  event_type varchar(32) [not null]
  payload json [not null, note: 'Non-sensitive, versioned metadata only; no plaintext reset/reapply token']
  secret_expires_at datetime(6)
  secret_ciphertext varbinary(2048) [note: 'AEAD ciphertext for one-time email link token; key stored outside DB; worker decrypts; scrub at terminal outcome or expiry']
  created_at datetime(6) [not null]
  available_at datetime(6) [not null, note: 'Earliest time publisher may send this event; use for publish retries']
  published_at datetime(6) [note: 'Set only after RabbitMQ publisher confirm; NULL means still eligible for publication']
  publish_attempts int [not null, default: 0]
  delivery_attempts int [not null, default: 0]
  outcome varchar(9) [note: 'NULL while unfinished, else SENT, FAILED or SKIPPED']
  finished_at datetime(6)
  last_error_code varchar(64)
  indexes {
    (published_at, available_at, id) [note: 'Single publisher polls unpublished due events']
    (outcome, finished_at, id) [note: 'Retention and terminal status query']
  }
  checks {
    `event_type IN ('STAFF_REGISTERED','STAFF_APPROVED','STAFF_REJECTED','PASSWORD_RESET','STAFF_REAPPLY_PROOF')`
    `(outcome IS NULL AND finished_at IS NULL) OR (outcome IN ('SENT','FAILED','SKIPPED') AND finished_at IS NOT NULL)`
    `publish_attempts >= 0 AND delivery_attempts >= 0`
    `secret_ciphertext IS NULL OR secret_expires_at IS NOT NULL`
    `available_at >= created_at`
  }
}

Table admin_notifications {
  id bigint [pk, increment]
  admin_user_id bigint [not null]
  approval_request_id bigint [not null, unique]
  created_at datetime(6) [not null]
  read_at datetime(6)
  indexes {
    (admin_user_id, read_at, created_at, id)
  }
}

Ref: staff_approval_requests.user_id > users.id
Ref: staff_approval_requests.decided_by > users.id
Ref: auth_sessions.user_id > users.id
Ref: refresh_tokens.session_id > auth_sessions.id
Ref: account_action_tokens.user_id > users.id
Ref: products.category_id > categories.id
Ref: purchase_receipts.supplier_id > suppliers.id
Ref: purchase_receipts.created_by > users.id
Ref: purchase_receipts.closed_by > users.id
Ref: purchase_receipt_items.receipt_id > purchase_receipts.id
Ref: purchase_receipt_items.product_id > products.id
Ref: inventory.product_id > products.id
Ref: inventory_adjustments.product_id > inventory.product_id
Ref: inventory_adjustments.actor_id > users.id
Ref: orders.created_by > users.id
Ref: orders.cancelled_by > users.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id
Ref: stock_movements.product_id > inventory.product_id
Ref: stock_movements.actor_id > users.id
Ref: stock_movements.(receipt_id, product_id) > purchase_receipt_items.(receipt_id, product_id)
Ref: stock_movements.(order_id, product_id) > order_items.(order_id, product_id)
Ref: stock_movements.(adjustment_id, product_id) > inventory_adjustments.(id, product_id)
Ref: idempotency_records.user_id > users.id
Ref: outbox_events.subject_user_id > users.id
Ref: admin_notifications.admin_user_id > users.id
Ref: admin_notifications.approval_request_id > staff_approval_requests.id

TableGroup Authentication {
  users
  staff_approval_requests
  auth_sessions
  refresh_tokens
  account_action_tokens
}
TableGroup Master_Data {
  categories
  suppliers
  products
}
TableGroup Purchasing {
  purchase_receipts
  purchase_receipt_items
}
TableGroup Inventory {
  inventory
  inventory_adjustments
  stock_movements
}
TableGroup Sales {
  orders
  order_items
}
TableGroup Idempotency {
  idempotency_records
}
TableGroup Outbox {
  outbox_events
}
TableGroup Notifications {
  admin_notifications
}
